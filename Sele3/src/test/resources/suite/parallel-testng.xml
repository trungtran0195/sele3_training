<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Parallel Browser Test Suite" parallel="classes" thread-count="2">
    <parameter name="config.file" value="src/test/resources/config/chrome.json"/>
    <parameter name="reporters" value="console,screenshot"/>

    <listeners>
        <listener class-name="com.listener.TestNgReporterListener"/>
        <listener class-name="com.listener.TestNgAssertionListener"/>
    </listeners>

    <test name="Parallel Browser Tests">
        <packages>
            <package name="com.tests"/>
        </packages>
    </test>
</suite>
