classDiagram
    %% ===============================
    %% CONFIGURATION LAYER
    %% ===============================
    class Configuration {
        +Browser browser
        +String baseUrl
        +boolean headless
        +String remote
        +boolean startMaximized
        +String browserSize
        +Duration timeout
        +Duration pageLoadTimeout
        +Duration pollingInterval
        +PageLoadStrategy pageLoadStrategy
        +MutableCapabilities capabilities
        +boolean isRemote()
    }

    class ConfigLoader {
        +static Configuration fromJsonFile(String jsonFile)
        +static Configuration fromSystemProperties()
        -static Configuration load(String file)
    }

    %% ===============================
    %% DRIVER MANAGEMENT CORE
    %% ===============================
    class DriverManager {
        -static ThreadLocal~WebDriver~ driver
        -static ThreadLocal~Configuration~ config
        +static void setConfig(Configuration)
        +static Configuration getConfig()
        +static void createDriver()
        +static WebDriver getDriver()
        +static void quitDriver()
        +static void cleanup()
    }

    class DriverFactory { +static WebDriver createDriver(Configuration) }
    class DriverContext {
        +static WebDriver getDriver()
        +static Configuration getConfig()
    }
    class ChromeManager { +static WebDriver create(Configuration) }
    class FirefoxManager { +static WebDriver create(Configuration) }
    class EdgeManager { +static WebDriver create(Configuration) }

    class Browser {
        <<enumeration>>
        CHROME
        FIREFOX
        EDGE
        +static Browser from(String value)
    }

    %% ===============================
    %% ELEMENT / WEBELEMENT
    %% ===============================
    class Element {
        -By locator
        +void click()
        +void sendKeys(String)
        +String getText()
        +String getAttribute(String)
        +boolean isDisplayed()
        +boolean isEnabled()
        +boolean isSelected()
        +Element findElement(By locator)
        +List<Element> findElements(By locator)
        +Element findElement(LocatorType type, String value)
        +List<Element> findElements(LocatorType type, String value)
        -WebElement locateVisible(By locator)
        +void waitForClickable(long timeout)
        +void waitForEnable(long timeout)
        +void scrollTo()
        +void verifyText(String expected, long intervalMs)
    }

    class LocatorType {
        <<enumeration>>
        XPATH
        CLASS_NAME
        ID
        CSS_SELECTOR
        NAME
        TAG_NAME
        LINK_TEXT
    }

    Element ..> LocatorType : uses locator strategy

    %% ===============================
    %% PAGE OBJECT LAYER
    %% ===============================
    class BasePage {
        +void open(String url)
    }

    class LoginPage {
        +Element usernameField
        +Element passwordField
        +Element loginButton
        +void enterUsername(String)
        +void enterPassword(String)
        +void clickLogin()
        +void login(String, String)
    }

    BasePage <|-- LoginPage
    LoginPage --> Element : uses

    %% ===============================
    %% ASSERTION LAYER
    %% ===============================
    class AssertionManager {
        +static void assertTrue(BooleanSupplier condition, String message)
        +static void assertEquals(String actual, String expected, String message)
        +static void softAssertTrue(BooleanSupplier condition, String message)
        +static void softAssertEquals(String actual, String expected, String message)
        +static void assertAll()
    }


    %% ===============================
    %% TEST BASE / TEST RUNNER
    %% ===============================
    class TestBase {
        +final void setup()
        +abstract void runTest()
        +final void tearDown()
    }

    class LoginTest {
        +void runTest()
    }

    TestBase <|-- LoginTest
    TestBase ..> AssertionManager : uses assertions
    Element --> AssertionManager : validates dynamic state

    %% ===============================
    %% REPORTER / LISTENER
    %% ===============================
    class Listener {
        <<interface>>
        +void onTestStart(TestEvent event)
        +void onTestSuccess(TestEvent event)
        +void onTestFailure(TestEvent event)
        +void onTestSkipped(TestEvent event)
        +void onRunFinish(TestEvent event)
    }

    class Reporter {
        <<interface>>
        +void startTest(TestEvent event)
        +void logSuccess(TestEvent event)
        +void logFailure(TestEvent event)
        +void logSkipped(TestEvent event)
        +void logSoftAssertionFailure(TestEvent event, String message)
        +void attachScreenshot(TestEvent event, byte[] screenshot)
        +void endTest(TestEvent event)
        +void flush()
    }

    class TestEvent {
        +String testId
        +String testName
        +String threadName
        +TestStatus status
        +Throwable error
        +Map~String,Object~ attributes
    }

    class TestStatus {
        <<enumeration>>
        STARTED
        PASSED
        FAILED
        SKIPPED
    }

    class DefaultListener {
        -List~Reporter~ reporters
    }

    class TestNGListenerAdapter
    class JUnitListenerAdapter
    class CustomRunnerAdapter
    class AllureReporter
    class ExtentReporter
    class ConsoleReporter

    DefaultListener ..|> Listener
    DefaultListener o-- Reporter : delegates to configured reporters
    DefaultListener ..> DriverContext : captures failure screenshot
    Listener ..> TestEvent : receives
    Reporter ..> TestEvent : reports
    TestEvent --> TestStatus : has status

    TestNGListenerAdapter --> Listener : converts TestNG events
    JUnitListenerAdapter --> Listener : converts JUnit events
    CustomRunnerAdapter --> Listener : converts runner events

    AllureReporter ..|> Reporter
    ExtentReporter ..|> Reporter
    ConsoleReporter ..|> Reporter

    %% ===============================
    %% RELATIONSHIPS
    %% ===============================
    ConfigLoader ..> Configuration : creates
    Configuration --> Browser : selects browser
    TestBase ..> ConfigLoader : loads per-test config
    TestBase ..> DriverManager : initializes and cleans up

    DriverManager *-- Configuration : owns per-thread config
    DriverManager *-- WebDriver : owns per-thread driver
    DriverManager ..> DriverFactory : delegates creation
    DriverFactory ..> Browser : dispatches by enum
    DriverFactory ..> ChromeManager
    DriverFactory ..> FirefoxManager
    DriverFactory ..> EdgeManager
    DriverContext ..> DriverManager : delegates access
    DriverContext --> WebDriver : returns current thread driver
    DriverContext --> Configuration : returns current thread config

    Element ..> DriverContext : gets current driver/config
    Element --> WebDriver : interacts with browser session
