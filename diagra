classDiagram
    %% ===============================
    %% CONFIGURATION LAYER
    %% ===============================
    class Configuration {
        <<immutable>>
        -final DriverConfig driver
        -final ElementConfig element
        -final ReportConfig report
        ~static ConfigurationBuilder builder()
    }

    class DriverConfig {
        <<immutable>>
        -final String browser
        -final boolean headless
        -final String baseUrl
        -final String remoteUrl
        -final boolean startMaximized
        -final String browserSize
        -final Duration pageLoadTimeout
        -final PageLoadStrategy pageLoadStrategy
        -final Map~String,Object~ options
        +boolean isRemote()
    }

    class ElementConfig {
        <<immutable>>
        -final Duration timeout
        -final Duration pollingInterval
    }

    class ReportConfig {
        <<immutable>>
        -final boolean enabled
        -final List~String~ reporters
        -final Path outputPath
        -final boolean screenshotOnFailure
        -final Map~String,Map~String,Object~~ options
    }

    class ConfigurationLoader {
        +static Configuration load()
        +static Configuration fromFile(String file)
        +static Configuration fromEnvironment()
    }

    class ConfigurationFileReader {
        -static MutableConfiguration fromJson(String file)
        -static MutableConfiguration fromProperties(String file)
    }

    class ConfigurationOverrides {
        -static Map driverSetters
        -static Map elementSetters
        -static Map reportSetters
        -static void applyProperties(MutableConfiguration, Properties)
        -static void applyEnvironment(MutableConfiguration)
        -static void applySystemProperties(MutableConfiguration)
    }

    class ConfigurationValueParser {
        -static boolean parseBoolean(String, String)
        -static Duration parseDuration(String, String)
        -static PageLoadStrategy parsePageLoadStrategy(String, String)
        -static Path parsePath(String, String)
        -static List~String~ parseProviderIds(String, String)
    }

    class ConfigurationResolver {
        -static Configuration resolve(MutableConfiguration)
    }

    class MutableConfiguration {
        <<DTO>>
    }

    ConfigurationLoader ..> ConfigurationFileReader : reads JSON/properties
    ConfigurationLoader ..> ConfigurationOverrides : applies env then CLI
    ConfigurationLoader ..> ConfigurationResolver : validates and creates immutable config
    ConfigurationFileReader ..> MutableConfiguration : loads
    ConfigurationOverrides ..> MutableConfiguration : overrides
    ConfigurationResolver ..> MutableConfiguration : validates and maps
    ConfigurationOverrides ..> ConfigurationValueParser : parses override values
    ConfigurationResolver ..> ConfigurationValueParser : parses typed values

    %% ===============================
    %% DRIVER MANAGEMENT CORE
    %% ===============================
    class DriverManager {
        -static ThreadLocal~WebDriver~ driver
        -static ThreadLocal~Configuration~ config
        +static void setConfig(Configuration)
        +static Configuration getConfig()
        +static void createDriver()
        +static WebDriver getDriver()
        +static void quitDriver()
        +static void cleanup()
    }

    class DriverFactory { +static WebDriver createDriver(Configuration) }
    class DriverProvider {
        <<interface>>
        +String id()
        +Set~String~ aliases()
        +WebDriver create(DriverConfig config)
    }

    class NamedProvider {
        <<interface>>
        +String id()
        +Set~String~ aliases()
    }

    class ProviderRegistry~T~ {
        -Map~String, T~ providers
        +T require(String id)
        +Map~String, T~ providers()
    }

    class DriverRegistry {
        -Map~String, DriverProvider~ providers
        +WebDriver create(DriverConfig config)
        +Map~String, DriverProvider~ providers()
    }

    class ChromeDriverProvider
    class FirefoxDriverProvider
    class EdgeDriverProvider

    ChromeDriverProvider ..|> DriverProvider
    FirefoxDriverProvider ..|> DriverProvider
    EdgeDriverProvider ..|> DriverProvider
    DriverProvider --|> NamedProvider
    DriverRegistry --> ProviderRegistry : delegates discovery
    ProviderRegistry o-- NamedProvider : discovers via ServiceLoader

    %% ===============================
    %% ELEMENT / WEBELEMENT
    %% ===============================
    class Element {
        -By locator
        +void click()
        +void sendKeys(String)
        +String getText()
        +String getAttribute(String)
        +boolean isDisplayed()
        +boolean isEnabled()
        +boolean isSelected()
        +Element findElement(By locator)
        +List<Element> findElements(By locator)
        +Element findElement(LocatorType type, String value)
        +List<Element> findElements(LocatorType type, String value)
        -WebElement locateVisible(By locator)
        +void waitForClickable(long timeout)
        +void waitForEnable(long timeout)
        +void scrollTo()
        +void verifyText(String expected, long intervalMs)
    }

    class LocatorType {
        <<enumeration>>
        XPATH
        CLASS_NAME
        ID
        CSS_SELECTOR
        NAME
        TAG_NAME
        LINK_TEXT
    }

    Element ..> LocatorType : uses locator strategy

    %% ===============================
    %% PAGE OBJECT LAYER
    %% ===============================
    class BasePage {
        +void open(String url)
    }

    class LoginPage {
        +Element usernameField
        +Element passwordField
        +Element loginButton
        +void enterUsername(String)
        +void enterPassword(String)
        +void clickLogin()
        +void login(String, String)
    }

    BasePage <|-- LoginPage
    LoginPage --> Element : uses

    %% ===============================
    %% ASSERTION LAYER
    %% ===============================
    class AssertionManager {
        +static void assertTrue(BooleanSupplier condition, String message)
        +static void assertEquals(String actual, String expected, String message)
        +static void softAssertTrue(BooleanSupplier condition, String message)
        +static void softAssertEquals(String actual, String expected, String message)
        +static void assertAll()
    }


    %% ===============================
    %% TEST BASE / TEST RUNNER
    %% ===============================
    class TestBase {
        +void setUp()
        +void tearDown()
    }
    Element --> AssertionManager : validates dynamic state

    %% ===============================
    %% REPORTER / LISTENER
    %% ===============================
    class Reporter {
        <<interface>>
        +void onStart(TestEvent event)
        +void onSuccess(TestEvent event)
        +void onFailure(TestEvent event)
        +void onSkipped(TestEvent event)
        +void attach(String name, String mediaType, byte[] content)
        +void flush()
    }

    class ReporterProvider {
        <<interface>>
        +String id()
        +Set~String~ aliases()
        +Reporter create(ReportConfig config)
    }

    class ReporterRegistry {
        -Map~String, ReporterProvider~ providers
        +List~Reporter~ createAll(ReportConfig config)
        +Map~String, ReporterProvider~ providers()
    }

    class TestEvent {
        +String testId
        +String testName
        +String threadName
        +TestStatus status
        +Throwable error
        +Map~String,Object~ attributes
    }

    class TestStatus {
        <<enumeration>>
        STARTED
        PASSED
        FAILED
        SKIPPED
    }

    class ReporterListener {
        -ThreadLocal~List~Reporter~~ currentReporters
        +void onStart(TestEvent event)
        +void onSuccess(TestEvent event)
        +void onFailure(TestEvent event)
        +void onSkipped(TestEvent event)
        +void flush()
    }

    class TestNgReporterListener {
        <<ITestListener>>
    }

    class JUnitReporterExtension {
        <<JUnit 5 Extension>>
    }

    class ConsoleReporterProvider
    class AllureReporterProvider
    class AllureReporter
    class ConsoleReporter

    ReporterListener o-- Reporter : delegates lifecycle events
    ReporterListener ..> ReporterRegistry : creates configured reporters
    ReporterListener ..> DriverManager : captures failure screenshot
    ReporterListener ..> TestEvent : receives
    TestNgReporterListener --> ReporterListener : adapts TestNG events
    JUnitReporterExtension --> ReporterListener : adapts JUnit events
    Reporter ..> TestEvent : reports
    TestEvent --> TestStatus : has status

    AllureReporter ..|> Reporter
    ConsoleReporter ..|> Reporter
    AllureReporterProvider ..|> ReporterProvider
    ConsoleReporterProvider ..|> ReporterProvider
    ReporterProvider --|> NamedProvider
    ReporterRegistry --> ProviderRegistry : delegates discovery
    ReporterProvider ..> Reporter : creates

    %% ===============================
    %% RELATIONSHIPS
    %% ===============================
    ConfigurationLoader ..> Configuration : creates
    Configuration *-- DriverConfig
    Configuration *-- ElementConfig
    Configuration *-- ReportConfig
    TestBase ..> ConfigurationLoader : loads per-test config
    TestBase ..> DriverManager : initializes and cleans up

    DriverManager *-- Configuration : owns per-thread config
    DriverManager *-- WebDriver : owns per-thread driver
    DriverManager ..> DriverFactory : delegates creation
    DriverFactory ..> DriverRegistry : resolves configured provider
    DriverProvider ..> DriverConfig : creates from
    Element ..> DriverManager : gets current driver/config
    Element ..> ElementConfig : uses timeout and polling
    Element --> WebDriver : interacts with browser session
    ReporterProvider ..> ReportConfig : creates from
